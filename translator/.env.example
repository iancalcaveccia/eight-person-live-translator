# Copy to translator/.env.local (never commit it). On LiveKit Cloud these are
# agent secrets: `lk agent create --secrets-file .env.local .`
# (add --ignore-empty-secrets if you leave optional values empty).
# Names are defined in docs/architecture/CONTRACT.md section 8.
# Keep comments on their own lines: secret-file parsers may not strip inline comments.

# LiveKit project (same project as the web app)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider: gemini | openai | mock
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-live-translate-preview
# Optional second provider. It cannot output Polish.
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
PROVIDER_FALLBACK=true
# true runs a second provider in parallel for comparison (doubles cost for es/en targets)
PROVIDER_COMPARE=false

# Control plane. REQUIRED in production; empty = standalone dev mode that admits everyone.
CONTROL_PLANE_URL=
INTERNAL_API_SECRET=

# Skip silent input for Gemini to save cost (pre-roll keeps speech onsets intact)
INPUT_GATE=true
# Conservative same-room microphone-bleed suppression
BLEED_GUARD=true
