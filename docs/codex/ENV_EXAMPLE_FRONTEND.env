# EXAMPLE ONLY. Not active until Codex implements/refactors secure routes.
# Copy to .env.local locally; enter real values ONLY in your secured local/server settings.
LIVEKIT_URL=wss://YOUR-LIVEKIT-PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ON_SERVER_ONLY
LIVEKIT_API_SECRET=REPLACE_ON_SERVER_ONLY
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000
GATHERING_MAX_HUMANS=8
MAX_GATHERING_SESSION_MINUTES=240
MAX_AI_SPEND_PER_GATHERING_USD=50
MAX_AI_SPEND_MONTHLY_USD=200
# Do NOT put LiveKit API secret, Gemini key or DB URL behind NEXT_PUBLIC_ variables.
