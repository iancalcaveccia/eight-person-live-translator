# Web app / control plane. Copy to .env.local for local development.
# Never put real values in this file or in any NEXT_PUBLIC_ variable except the app URL.

# LiveKit Cloud project (server-side only)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Managed Postgres (Neon/Supabase). Leave empty locally to use the embedded dev database (PGlite in ./.data).
DATABASE_URL=

# Shared with the translator worker for signed admission/usage calls.
INTERNAL_API_SECRET=
# Derives invite links. Optional locally (a random value is stored in the dev database).
APP_SECRET=
# Required to create gatherings (required on hosted deployments).
HOST_ACCESS_CODE=
# Vercel Cron sends this as a bearer token to /api/cron/cleanup.
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limits (defaults shown)
GATHERING_MAX_HUMANS=8
MAX_GATHERING_SESSION_MINUTES=360
GATHERING_IDLE_END_MINUTES=30
MAX_AI_SPEND_PER_GATHERING_USD=50
MAX_AI_SPEND_MONTHLY_USD=200
# MAX_AI_SPEND_DAILY_USD=
MEDIA_TOKEN_TTL_SECONDS=600

# Cost meter rates (USD per minute of audio; re-check provider pricing)
GEMINI_INPUT_USD_PER_MIN=0.0053
GEMINI_OUTPUT_USD_PER_MIN=0.0315
OPENAI_TRANSLATE_USD_PER_MIN=0.034
